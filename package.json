{
    "name": "light-phone-manager",
    "productName": "Light Phone Manager",
    "version": "1.1.0",
    "description": "Manage sideloaded tools on your Light Phone 3 — track GitHub repos, install and update APKs, all with adb bundled in.",
    "main": "src/main/main.js",
    "author": "Light Phone Manager",
    "license": "MIT",
    "private": true,
    "scripts": {
        "start": "electron .",
        "fetch-platform-tools": "node scripts/fetch-platform-tools.js",
        "fetch-light-cli": "node scripts/fetch-light-cli.js",
        "generate-podcastindex-key": "node scripts/generate-podcastindex-key.js",
        "predist": "node scripts/fetch-platform-tools.js && node scripts/fetch-light-cli.js && node scripts/generate-podcastindex-key.js",
        "dist": "electron-builder",
        "dist:win": "node scripts/fetch-platform-tools.js && node scripts/fetch-light-cli.js win32 && node scripts/generate-podcastindex-key.js && electron-builder --win",
        "dist:mac": "node scripts/fetch-platform-tools.js && node scripts/fetch-light-cli.js darwin && node scripts/generate-podcastindex-key.js && electron-builder --mac",
        "dist:linux": "node scripts/fetch-platform-tools.js && node scripts/fetch-light-cli.js linux && node scripts/generate-podcastindex-key.js && electron-builder --linux"
    },
    "build": {
        "appId": "com.greghare.lightphonemanager",
        "productName": "Light Phone Manager",
        "publish": {
            "provider": "github",
            "owner": "greghare",
            "repo": "light-phone-manager"
        },
        "directories": {
            "output": "dist"
        },
        "files": [
            "**/*",
            "!node_modules/**/{CHANGELOG.md,README.md,readme.md}"
        ],
        "asarUnpack": [
            "node_modules/@ffmpeg-installer/**"
        ],
        "extraResources": [
            {
                "from": "resources/README-light-cli.txt",
                "to": "light-cli/README.txt"
            },
            {
                "from": "resources/light-cli/run_light.py",
                "to": "light-cli/run_light.py"
            },
            {
                "from": "resources/light-cli/notes_cli.py",
                "to": "light-cli/notes_cli.py"
            }
        ],
        "mac": {
            "target": [
                "zip",
                "dmg"
            ],
            "identity": null,
            "extraResources": [
                {
                    "from": "resources/platform-tools/darwin",
                    "to": "platform-tools"
                },
                {
                    "from": "resources/light-cli/darwin",
                    "to": "light-cli/darwin"
                }
            ]
        },
        "linux": {
            "target": [
                "AppImage",
                "deb"
            ],
            "maintainer": "Light Phone Manager <noreply@example.com>",
            "extraResources": [
                {
                    "from": "resources/platform-tools/linux",
                    "to": "platform-tools"
                },
                {
                    "from": "resources/light-cli/linux",
                    "to": "light-cli/linux"
                }
            ]
        },
        "win": {
            "target": [
                "nsis"
            ],
            "extraResources": [
                {
                    "from": "resources/platform-tools/win32",
                    "to": "platform-tools"
                },
                {
                    "from": "resources/light-cli/win32",
                    "to": "light-cli/win32"
                }
            ]
        }
    },
    "dependencies": {
        "@ffmpeg-installer/ffmpeg": "^1.1.0",
        "app-info-parser": "^1.1.6"
    },
    "devDependencies": {
        "electron": "^35.7.5",
        "electron-builder": "^24.13.3",
        "extract-zip": "^2.0.1"
    }
}
